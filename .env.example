# ===========================================================================
# ORCA Maritime Platform — Root Production Environment Variables
# Copy this file to .env before running docker compose:
#   cp .env.example .env
# ===========================================================================

# 1. Security Keys (Generate with: openssl rand -hex 32)
# INTERNAL_SECRET MUST be byte-identical across Backend and AI Service
INTERNAL_SECRET=8f9a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a
JWT_SECRET=1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b

# 2. Domain & Frontend Origins (Comma-separated)
ALLOWED_ORIGINS=https://orca.yourdomain.com,http://localhost:80,http://localhost:5173

# 3. Telemetry Mode ('live' for real Copernicus/Open-Meteo/INCOIS APIs, 'mock' for testing)
ADAPTER_MODE=live

# 4. Optional: Gemini LLM API Key for enhanced natural language synthesis
GEMINI_API_KEY=

# 5. Production Domain (Used by SSL initialization script)
DOMAIN_NAME=orca.yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com

# ===========================================================================
# 6. External Data Feeds & API Endpoints (Change anytime from .env)
# ===========================================================================
# INCOIS Potential Fishing Zones OGC WFS endpoint
INCOIS_WFS_URL=https://incois.gov.in/geoserver/PFZ_Automation/wfs?service=WFS&version=1.0.0&request=GetFeature&typeName=PFZ_Automation:pfzlines&outputFormat=application/json

# Open-Meteo Atmospheric Weather API
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast

# Open-Meteo Marine & Copernicus Wave Model API
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine

# NDMA SACHET National Disaster Alert Feed (Cyclone & Squalls)
SACHET_ALERTS_URL=https://sachet.ndma.gov.in/cap_public_website/FetchAllAlertDetails

# GEBCO High-Resolution Global Bathymetry Grid API
GEBCO_BATHYMETRY_URL=https://api.opentopodata.org/v1/gebco2020

# Optional: Bhashini Indic Voice Proxy API
BHASHINI_API_URL=
BHASHINI_API_KEY=
