# ===========================================================================
# ORCA AI Service (.env)
# ===========================================================================
ENV=production
AI_SERVICE_PORT=8000
LOG_LEVEL=INFO

# Backend Internal Callback (Port 4100)
BACKEND_INTERNAL_URL=http://localhost:4100

# Required: Shared 64-char HMAC secret (identical to Backend)
INTERNAL_SECRET=8f9a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB=orca

# Telemetry mode ('live' for real Open-Meteo & Copernicus; 'mock' for offline testing)
ADAPTER_MODE=live

# Optional Gemini LLM Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
USE_MOCK_LLM=false
