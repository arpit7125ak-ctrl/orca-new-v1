# ORCA AI Service — environment configuration
# Copy to .env and fill in. NEVER commit .env.

# --- Service ---------------------------------------------------------------
AI_SERVICE_PORT=8000
LOG_LEVEL=INFO
ENV=development

# --- Backend internal API --------------------------------------------------
# The Backend's INTERNAL server (port 4100), not the public one (4000).
BACKEND_INTERNAL_URL=http://localhost:4100

# MUST be byte-identical to the Backend's INTERNAL_SECRET. This is what signs
# the x-internal-token JWT in both directions.
INTERNAL_SECRET=change-me-must-match-backend-exactly

# --- Gemini ----------------------------------------------------------------
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Set true to skip every real Gemini call and use deterministic stub responses.
# Useful for offline work, CI, and demo rehearsal without burning quota.
USE_MOCK_LLM=false

# --- Adapters --------------------------------------------------------------
# mock  = deterministic fake data, no network (Phase A3)
# real  = live INCOIS/IMD/etc. adapters (Phase A4)
ADAPTER_MODE=mock
