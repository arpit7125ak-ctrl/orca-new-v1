{
  "$id": "https://orca.sih26176/schemas/db/GeofenceEventDocument.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GeofenceEventDocument",
  "description": "MongoDB `geofence_events` collection document — audit record of each geofence check. Fills the gap flagged earlier: §66.3 requires audit storage but this collection is absent from §99's list — needs to be written directly into the architecture doc per the no-addendum rule. state/constraint_type enums kept identical to api/GeofenceCheckResponse.json.",
  "type": "object",
  "required": ["lat", "lon", "state", "created_at"],
  "properties": {
    "device_id": { "type": ["string", "null"], "description": "For dedup lookups. §66.3" },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "state": {
      "type": "string",
      "enum": ["clear", "approaching", "inside"]
    },
    "layer_name": { "type": ["string", "null"] },
    "constraint_type": { "type": ["string", "null"], "enum": ["prohibited", "conditional", "warning_only", null] },
    "distance_km": { "type": ["number", "null"] },
    "bearing_deg": { "type": ["number", "null"], "minimum": 0, "maximum": 360 },
    "deduplicated": { "type": "boolean", "default": false },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
