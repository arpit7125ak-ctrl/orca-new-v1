{
  "$id": "https://orca.sih26176/schemas/Freshness.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Freshness",
  "description": "Temporal-quality dimension of a data field, kept separate from DataFieldStatus. §42, §43",
  "type": "object",
  "required": ["state"],
  "properties": {
    "state": {
      "type": "string",
      "enum": ["fresh", "cached", "stale", "near_real_time", "unknown"]
    },
    "age_hours": { "type": ["number", "null"] },
    "max_age_hours": {
      "type": ["number", "null"],
      "description": "Registry-configured freshness_max_hours for this source. §22.1"
    }
  },
  "additionalProperties": false
}
