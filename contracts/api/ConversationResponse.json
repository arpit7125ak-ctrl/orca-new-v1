{
  "$id": "https://orca.sih26176/schemas/api/ConversationResponse.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConversationResponse",
  "description": "Response body for GET /api/v1/chat/:conversation_id and GET /api/v1/chat/:conversation_id/history. §103 does not distinguish these two endpoints' payloads; both return this shape. §91",
  "type": "object",
  "required": ["conversation_id", "messages"],
  "properties": {
    "conversation_id": { "type": "string" },
    "current_context": {
      "type": ["object", "null"],
      "description": "Relevant context carried forward — current location, activity, vessel. §91",
      "properties": {
        "location": { "oneOf": [{ "$ref": "../shared/Location.json" }, { "type": "null" }] },
        "activity": { "type": ["string", "null"] },
        "vessel_type": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "text", "timestamp"],
        "properties": {
          "role": { "type": "string", "enum": ["user", "orca"] },
          "text": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "detected_language": { "type": ["string", "null"], "description": "For role='user' messages. §91" },
          "response_language": { "type": ["string", "null"], "description": "For role='orca' messages." },
          "analysis_id": { "type": ["string", "null"], "description": "Analysis this message is linked to, if any." }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
