{
  "$id": "https://orca.sih26176/schemas/TrendResult.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TrendResult",
  "description": "Historical/Trend Agent output. Serves both the internal AI Service → Backend result and any direct API response for trend requests — one shape, no separate envelope. §72. OPEN QUESTION: modeled here as a single Location's time series; if historical sampling ever uses multiple fixed points (§17.1's 'historical' point_id mode implies it might), this may need a per-point breakdown — flagging rather than guessing.",
  "type": "object",
  "required": ["trend_id", "status", "location", "parameter"],
  "properties": {
    "trend_id": { "type": "string" },
    "analysis_id": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": ["queued", "running", "completed", "failed"]
    },
    "error": { "oneOf": [{ "$ref": "shared/ErrorInfo.json" }, { "type": "null" }] },
    "location": { "$ref": "shared/Location.json" },
    "parameter": {
      "type": "string",
      "description": "e.g. 'sst', 'chlorophyll'. Configured ocean/ecosystem time series parameter. §72.1"
    },
    "period": {
      "type": ["object", "null"],
      "properties": {
        "baseline_start": { "type": "string", "format": "date" },
        "baseline_end": { "type": "string", "format": "date" },
        "analysis_start": { "type": "string", "format": "date" },
        "analysis_end": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "monthly_means": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["month", "value", "unit"],
        "properties": {
          "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
          "value": { "type": "number" },
          "unit": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "anomalies": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["month", "anomaly_value", "unit"],
        "properties": {
          "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
          "anomaly_value": { "type": "number" },
          "anomaly_pct": { "type": ["number", "null"] },
          "unit": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "trend_direction": {
      "type": ["string", "null"],
      "enum": ["increasing", "decreasing", "stable", "insufficient_data", null]
    },
    "trend_magnitude": { "type": ["number", "null"] },
    "unusual_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["period_start", "period_end", "event_type"],
        "properties": {
          "period_start": { "type": "string", "format": "date" },
          "period_end": { "type": "string", "format": "date" },
          "event_type": { "type": "string", "description": "e.g. 'marine_heatwave', 'low_chlorophyll_period'. Free string, not closed. §72.1" },
          "description": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "unobserved_factors": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Factors ORCA cannot observe (fishing pressure, market, policy), explicitly named as unobserved rather than implied as causal. §72.2"
    },
    "explanation": {
      "type": ["string", "null"],
      "description": "LLM-generated. Must separate correlation from causation. §72.2"
    },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "data_quality": { "oneOf": [{ "$ref": "shared/DataQuality.json" }, { "type": "null" }] },
    "generated_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
