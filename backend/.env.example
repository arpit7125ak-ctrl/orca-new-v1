# ORCA Backend — environment template
# Copy this to .env and fill in real values. .env itself must never be committed.

NODE_ENV=development

# --- Public API server (Frontend-facing) ---
PORT=4000

# --- Internal API server (AI Service-facing only, never exposed to the internet) ---
INTERNAL_PORT=4100
# Shared secret used both ways: Backend -> AI Service (aiService.client.js)
# and AI Service -> Backend (internalAuth.js middleware on /internal/v1/*)
INTERNAL_SECRET=replace-with-a-long-random-string

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/orca

# --- AI Service ---
AI_SERVICE_URL=http://localhost:8000

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- Auth (NEW/PROPOSED — SS103 has no endpoints for User.json; see architecture doc flag) ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Web Push (alert delivery) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.com

# --- Bhashini (voice proxy) ---
BHASHINI_API_URL=
BHASHINI_API_KEY=

# --- Logging ---
LOG_LEVEL=info
