# ===========================================================================
# ORCA Backend Gateway (.env)
# ===========================================================================
NODE_ENV=production
PORT=4000
INTERNAL_PORT=4100

# Required: Shared 64-char HMAC secret (identical to AI Service)
INTERNAL_SECRET=8f9a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a
JWT_SECRET=1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/orca

# AI Service URL
AI_SERVICE_URL=http://localhost:8000

# CORS Allowed Origins
ALLOWED_ORIGINS=https://orca.yourdomain.com,http://localhost:5173

# Logging
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# External Data Feeds & APIs (Change anytime from .env)
# ---------------------------------------------------------------------------
INCOIS_WFS_URL=https://incois.gov.in/geoserver/PFZ_Automation/wfs?service=WFS&version=1.0.0&request=GetFeature&typeName=PFZ_Automation:pfzlines&outputFormat=application/json

# Optional: Bhashini Voice Proxy
BHASHINI_API_URL=
BHASHINI_API_KEY=
