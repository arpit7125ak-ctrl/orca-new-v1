{
  "name": "orca-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ORCA (SIH26176) backend — receives, validates, persists, and tracks marine analysis requests; the only layer allowed to talk to the AI Service or MongoDB.",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "internal": "node src/internal-server.js",
    "start:internal": "node src/internal-server.js",
    "worker": "node src/worker.js",
    "dev": "nodemon src/server.js",
    "dev:internal": "nodemon src/internal-server.js",
    "dev:worker": "nodemon src/worker.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:contract": "jest tests/contract",
    "seed:gis": "node scripts/seed-gis-layers.js",
    "seed:zones": "node scripts/seed-all-indian-zones.js",
    "seed:ports": "node scripts/seed-ports.js",
    "seed:pfz": "node scripts/seed-pfz.js",
    "create-indexes": "node scripts/create-indexes.js",
    "validate-schemas": "node scripts/validate-schemas.js",
    "check": "node scripts/check-syntax.js && python3 scripts/check-contracts.py",
    "check:contracts": "python3 scripts/check-contracts.py",
    "test:decision": "node scripts/test-decision.js"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axios": "^1.7.4",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "node-cron": "^3.0.3",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "testTimeout": 15000
  }
}
